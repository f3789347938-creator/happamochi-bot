# ===========================================================================
# 葉っぱもち Bot / 環境変数のサンプル
# ---------------------------------------------------------------------------
# ここに書いてある値はすべてダミーです。実際の値は絶対にコミットしないこと。
# ローカル開発では、このファイルを .dev.vars にコピーして値を書き換えます。
#   cp .env.example .dev.vars
# 本番(Cloudflare Pages)へは wrangler の secret として設定します。
#   printf '%s' "$LINE_CHANNEL_ACCESS_TOKEN" | \
#     npx wrangler pages secret put LINE_CHANNEL_ACCESS_TOKEN \
#     --project-name line-group-bbs
#   ※ secret は「次回のデプロイ以降」に反映されます。
# ===========================================================================

# LINE Developers > Messaging API チャネル > 「チャネルシークレット」
# Webhookの署名検証に使います。これが違うと全リクエストが401になります。
LINE_CHANNEL_SECRET=00000000000000000000000000000000

# LINE Developers > Messaging API チャネル > 「チャネルアクセストークン(長期)」
# Reply API の呼び出しに使います。
# 本BOTは Push API を一切使いません(無料枠を消費しないため)。
LINE_CHANNEL_ACCESS_TOKEN=dummy_channel_access_token_replace_me

# 管理画面(/gallery の管理機能)のログインパスワード
GALLERY_ADMIN_PASSWORD=change_me_please

# 管理画面のセッションCookieに署名するための秘密鍵(十分に長いランダム文字列)
GALLERY_ADMIN_SECRET=replace_with_a_long_random_string

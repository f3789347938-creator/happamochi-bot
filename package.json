{
  "name": "happamochi-bot",
  "type": "module",
  "scripts": {
    "call-monitor:test": "node --test workers/group-call-monitor/tests/*.test.mjs",
    "call-monitor:deploy": "wrangler deploy --config workers/group-call-monitor/wrangler.jsonc",
    "dev": "vite",
    "build:help": "node --experimental-strip-types scripts/render-help-assets.mjs",
    "build": "npm run build:help && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "chess.js": "^1.4.0",
    "hono": "^4.13.5",
    "satori": "0.32.0",
    "satori-html": "^0.3.2"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.64.0"
  }
}

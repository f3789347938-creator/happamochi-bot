{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "happamochi-group-call-monitor",
  "main": "index.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "OA_BOT_ID": "Ucc21cbcb817af4a3b91def3ab6e04c09",
    "TEST_CHAT_ID": "Cf2b0d931f735b48b044c47d841a32fda",
    "CHAT_SCOPE": "all",
    "SEND_ENABLED": "true",
    "STREAM_SECONDS": "40"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "line-group-bbs-db",
    "database_id": "f17e1465-7471-45a5-9217-c9b408cde5ec"
  }]
}
